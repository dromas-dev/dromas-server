## Revoke, the address and certificates through 9
UpdateItem {
 "ConditionExpression": "attribute_not_exists(#t) OR #t \u003c :t",
 "ExpressionAttributeNames": {
  "#c": "revoked_certs",
  "#i": "identity",
  "#r": "revocation",
  "#s": "revoked_certs_sig",
  "#t": "through"
 },
 "ExpressionAttributeValues": {
  ":c": {
   "B": "Y2VydGlmaWNhdGVz"
  },
  ":i": {
   "B": "YW4gaWRlbnRpdHkgZG9jdW1lbnQ="
  },
  ":r": {
   "B": "YSByZXZvY2F0aW9u"
  },
  ":s": {
   "B": "dGhlaXIgc2lnbmF0dXJl"
  },
  ":t": {
   "N": "9"
  }
 },
 "Key": {
  "addr": {
   "B": "sAEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
  },
  "sk": {
   "B": "AQ=="
  }
 },
 "ReturnValues": "ALL_NEW",
 "TableName": "mailboxes",
 "UpdateExpression": "SET #i = if_not_exists(#i, :i), #r = if_not_exists(#r, :r), #c = :c, #s = :s, #t = :t"
}
