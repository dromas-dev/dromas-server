## Adopt
TransactWriteItems {
 "TransactItems": [
  {
   "Update": {
    "ConditionExpression": "#rev = :old",
    "ExpressionAttributeNames": {
     "#acct": "account",
     "#rev": "rev"
    },
    "ExpressionAttributeValues": {
     ":acct": {
      "B": "YW4gYWNjb3VudA=="
     },
     ":new": {
      "N": "4"
     },
     ":old": {
      "N": "3"
     }
    },
    "Key": {
     "addr": {
      "B": "sAEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
     },
     "sk": {
      "B": "AA=="
     }
    },
    "TableName": "mailboxes",
    "UpdateExpression": "SET #acct = :acct, #rev = :new"
   }
  },
  {
   "Update": {
    "ConditionExpression": "#u \u003e= :one AND #e \u003e :now",
    "ExpressionAttributeNames": {
     "#e": "expires",
     "#u": "uses"
    },
    "ExpressionAttributeValues": {
     ":now": {
      "N": "1792843200000"
     },
     ":one": {
      "N": "1"
     }
    },
    "Key": {
     "account": {
      "B": "YW4gYWNjb3VudA=="
     },
     "sk": {
      "B": "BK0HAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
     }
    },
    "TableName": "accounts",
    "UpdateExpression": "SET #u = #u - :one"
   }
  }
 ]
}
